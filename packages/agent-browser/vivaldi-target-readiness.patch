+/// Vivaldi acknowledges `Target.createTarget` before the renderer accepts
+/// commands on a flattened session. Attaching immediately produces a session
+/// whose `Page.enable` never answers. Give newly-created renderers a short
+/// readiness window before the first attach.
+pub(super) async fn wait_for_new_target_ready() {
+    tokio::time::sleep(Duration::from_millis(100)).await;
+}
